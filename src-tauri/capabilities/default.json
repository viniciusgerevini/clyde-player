{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "about"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    "fs:default",
    "fs:allow-app-meta",
    "store:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
